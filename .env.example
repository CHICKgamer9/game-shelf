# Game Shelf — copy to .env.local for local development.
# Never commit real secrets. Guest mode works with none of these set.

# --- Clerk (hosted auth: magic link + Google; Apple optional) ---
# Create an application at https://dashboard.clerk.com
# Enable Email (one-time / magic link) and Google. Apple is optional.
# Add these redirect URLs in Clerk:
#   http://localhost:3000
#   https://game-shelf-five.vercel.app
#   https://*.vercel.app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Neon Postgres (items + tombstones, scoped by Clerk user id) ---
# Vercel Dashboard → game-shelf → Storage → Create Database → Neon
# or Marketplace → Neon → create a project and connect it to game-shelf.
# That injects DATABASE_URL for production / preview / development.
DATABASE_URL=

# --- Vercel Blob (compressed item photos) ---
# Already provisioned as store `game-shelf-photos` and connected to this
# Vercel project. Re-creating the store will mint a new token.
# Locally: `vercel env pull .env.local` after `vercel link`.
BLOB_READ_WRITE_TOKEN=
